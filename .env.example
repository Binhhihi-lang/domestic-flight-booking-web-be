# =====================================================================
# .env.example — MẪU cấu hình môi trường (được commit lên git)
# Copy file này thành .env rồi điền giá trị thật vào.
#
#   cp .env.example .env      (Linux/macOS/Git Bash)
#   copy .env.example .env    (Windows CMD)
#
# LƯU Ý QUAN TRỌNG về định dạng (Spring đọc theo cú pháp .properties):
#   - KHÔNG dùng "export KEY=value"
#   - KHÔNG bọc giá trị trong dấu nháy "..."
#   - Mỗi dòng: KEY=value, không có khoảng trắng quanh dấu =
# =====================================================================

# ===== Database — Aiven PostgreSQL =====
# Bắt buộc có tiền tố "jdbc:" ở đầu (thiếu sẽ lỗi khi khởi động).
# Tên database đang dùng là defaultdb. Aiven yêu cầu sslmode=require.
FLIGHTBOOKING_DB_URL=jdbc:postgresql://HOST:PORT/defaultdb?sslmode=require
DB_FB_USERNAME=avnadmin
DB_FB_PASSWORD=CHANGE_ME

# ===== Cloudinary (upload ảnh) =====
CLOUDINARY_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
