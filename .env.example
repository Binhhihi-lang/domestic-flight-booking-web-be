# =====================================================================
# .env.example — MẪU cấu hình môi trường (được commit lên git)
# Copy file này thành .env rồi điền giá trị thật vào.
#
#   cp .env.example .env      (Linux/macOS/Git Bash)
#   copy .env.example .env    (Windows CMD)
#
# LƯU Ý QUAN TRỌNG về định dạng (Spring đọc theo cú pháp .properties):
#   - KHÔNG dùng "export KEY=value"
#   - KHÔNG bọc giá trị trong dấu nháy "..."
#   - Mỗi dòng: KEY=value, không có khoảng trắng quanh dấu =
# =====================================================================

# ===== Database — Aiven PostgreSQL =====
# Bắt buộc có tiền tố "jdbc:" ở đầu (thiếu sẽ lỗi khi khởi động).
# Tên database đang dùng là defaultdb. Aiven yêu cầu sslmode=require.
FLIGHTBOOKING_DB_URL=jdbc:postgresql://HOST:PORT/defaultdb?sslmode=require
DB_FB_USERNAME=avnadmin
DB_FB_PASSWORD=CHANGE_ME

# ===== Cloudinary (upload ảnh) =====
CLOUDINARY_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# ===== Redis (blacklist access token + whitelist refresh token) =====
# Chạy local bằng: docker compose up -d redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ===== JWT =====
# Khóa ký HS256 — tối thiểu 32 ký tự, sinh bằng: openssl rand -base64 32
JWT_SIGNER_KEY=CHANGE_ME_MIN_32_CHARS
# Thời hạn access token (giây), mặc định 1 giờ
JWT_ACCESS_DURATION=3600
# Thời hạn tối đa của phiên refresh (giây), mặc định 14 ngày
JWT_REFRESHABLE_DURATION=1209600

# ===== Email đặt lại mật khẩu (AUTH-04) =====
# MAIL_ENABLED=false → KHÔNG gửi thư thật, liên kết đặt lại mật khẩu chỉ ghi
# ra log của app (dùng khi dev). Đặt true khi đã điền đủ SMTP bên dưới.
MAIL_ENABLED=false
# Địa chỉ gửi đi (phải được nhà cung cấp SMTP cho phép gửi)
MAIL_FROM=no-reply@vinafly.local

# SMTP — ví dụ Gmail dùng App Password (không phải mật khẩu đăng nhập):
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
#   MAIL_USERNAME=your.address@gmail.com  MAIL_PASSWORD=<app-password 16 ký tự>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== Liên kết đặt lại mật khẩu =====
# Gốc URL trang quên mật khẩu của FE; backend nối thêm "?token=<uuid>".
AUTH_RESET_LINK_BASE=http://localhost:4200/forgot-password
# FALSE (mặc định, nên để vậy): token CHỈ đi qua email — người dùng phải mở
# hộp thư bấm liên kết. Chỉ đặt TRUE khi cần test luồng đặt lại mà không có
# hộp thư thật; khi đó token hiện thẳng trên màn hình, ai cũng đặt lại được.
AUTH_EXPOSE_RESET_TOKEN=false
